{
  "$description": "Design tokens (W3C DTCG-style). Single source for colors and symbols in web, terminal and MCP output. In production, compile with Style Dictionary.",
  "tone": {
    "neutral": { "color": { "$value": "#868e96" }, "symbol": { "$value": "·" } },
    "info":    { "color": { "$value": "#1c7ed6" }, "symbol": { "$value": "○" } },
    "success": { "color": { "$value": "#2f9e44" }, "symbol": { "$value": "✓" } },
    "warning": { "color": { "$value": "#e8590c" }, "symbol": { "$value": "◆" } },
    "danger":  { "color": { "$value": "#e03131" }, "symbol": { "$value": "▲" } },
    "accent":  { "color": { "$value": "#4c6ef5" }, "symbol": { "$value": "›" } }
  },
  "surface": {
    "light": { "bg": { "$value": "#f6f7f9" }, "card": { "$value": "#ffffff" }, "fg": { "$value": "#1d2330" }, "muted": { "$value": "#6b7280" }, "line": { "$value": "#e3e6ea" } },
    "dark":  { "bg": { "$value": "#111418" }, "card": { "$value": "#1a1e24" }, "fg": { "$value": "#e6e8eb" }, "muted": { "$value": "#9aa1ab" }, "line": { "$value": "#2b3038" } }
  },
  "atom": {
    "tag":   { "prefix": { "$value": "#" } },
    "empty": { "$value": "—" }
  }
}
